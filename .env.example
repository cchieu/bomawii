# ==========================================
# BomaWiFi Environment Variables (.env.example)
# Do NOT place real secrets in this template file!
# ==========================================

# Base Application URL (Cloud Run or custom domain)
APP_URL="https://your-domain.com"

# HotSpot Business Details
HOTSPOT_NAME="BomaWiFi High-Speed Hotspot"
HOTSPOT_LOCATION="Nairobi, Kenya"
SUPPORT_PHONE="+254700000000"

# ------------------------------------------
# Safaricom Daraja M-Pesa STK Push Settings
# ------------------------------------------
# Set to 'sandbox' for testing, 'production' for live payments
DARAJA_ENVIRONMENT="sandbox"

# Daraja Developer Portal credentials (https://developer.safaricom.co.ke)
DARAJA_CONSUMER_KEY="your_daraja_consumer_key_here"
DARAJA_CONSUMER_SECRET="your_daraja_consumer_secret_here"

# Lipa Na M-Pesa Online Passkey (from Daraja test credentials or Go-Live email)
DARAJA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"

# Lipa Na M-Pesa Shortcode (sandbox default is 174379; live will be your Paybill or Till)
DARAJA_SHORTCODE="174379"

# Public HTTPS Callback URL where Safaricom sends payment confirmation webhooks
# Defaults to ${APP_URL}/api/payments/daraja-callback
DARAJA_CALLBACK_URL="https://your-domain.com/api/payments/daraja-callback"

# ------------------------------------------
# MikroTik RouterOS Hotspot Settings
# ------------------------------------------
# Set to 'mock' for local dev without hardware, or 'live' to connect to RouterOS
ROUTER_MODE="mock"

# IP or hostname of MikroTik router (e.g., 192.168.88.1 or VPN endpoint)
ROUTEROS_HOST="192.168.88.1"

# RouterOS API port (standard API is 8728, API-SSL is 8729, REST API is 443/80)
ROUTEROS_PORT="8728"
ROUTEROS_USE_SSL="false"

# RouterOS API user credentials (create a dedicated user in /user group=write)
ROUTEROS_USER="api_hotspot"
ROUTEROS_PASSWORD="strong_router_password_here"

# MikroTik Hotspot server name configured under /ip hotspot
HOTSPOT_SERVER_NAME="hotspot1"

# ------------------------------------------
# Admin Security
# ------------------------------------------
ADMIN_BOOTSTRAP_EMAIL="calebchieu@gmail.com"
